# Скопіюйте цей файл у backend/.env і заповніть значення. Файл .env НЕ комітиться в Git.

# ---------- MongoDB Atlas ----------
# Atlas → Database → Connect → Drivers → Python. Замініть <password> на пароль користувача БД
MONGODB_URI=mongodb+srv://nevpade:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=nevpade

# ---------- JWT ----------
# Будь-який довгий випадковий рядок, напр.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# ---------- CORS: адреси фронтенду через кому (без / в кінці) ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Google (той самий Client ID, що й VITE_GOOGLE_CLIENT_ID у frontend/.env) ----------
GOOGLE_CLIENT_ID=

# ---------- Facebook (необов'язково) ----------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---------- Пошта для кодів підтвердження ----------
# console — код лише пишеться в лог сервера (зручно для розробки)
# brevo   — HTTP API Brevo (працює і на безкоштовному Render, де SMTP заблоковано)
# smtp    — напр. Gmail з паролем застосунку (лише локально)
EMAIL_PROVIDER=console
EMAIL_FROM=
EMAIL_FROM_NAME=NeVpade
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- SMS для підтвердження телефону ----------
# console — код пишеться в лог сервера; turbosms — сервіс TurboSMS (turbosms.ua)
SMS_PROVIDER=console
TURBOSMS_TOKEN=
TURBOSMS_SENDER=

# ---------- Демо-режим ----------
# Якщо задати (напр. 123456), усі коди підтвердження будуть такими. Лише для захисту курсової/тестів!
DEV_FIXED_CODE=

DEFAULT_FUEL_PRICE=56
DEBUG=false
