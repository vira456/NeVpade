# true — працювати на мокових даних, false — на реальному сервері
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000/api
VITE_GOOGLE_MAPS_KEY=

# Вхід через соцмережі (працює лише при VITE_USE_MOCK=false)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
VITE_GOOGLE_CLIENT_ID=
# developers.facebook.com → My Apps → App ID
VITE_FACEBOOK_APP_ID=
